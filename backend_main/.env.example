# ============================================================
#  DevPilot backend — copy to .env and fill in. Never commit .env.
# ============================================================

# ── Application ────────────────────────────────────────────
APP_NAME=DevPilot
ENVIRONMENT=development        # development | staging | production | test
DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
# Regex of extra origins. Unset = any localhost port outside production (Flutter web dev builds).
CORS_ORIGIN_REGEX=
LOG_LEVEL=INFO
LOG_JSON=false                 # true in production (one JSON object per line)

# ── Storage and event bus ──────────────────────────────────
# memory = single process, nothing to install. Use mongo + redis to run
# several API replicas and workers against the same missions.
STORAGE_BACKEND=memory         # memory | mongo
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=devpilot
BUS_BACKEND=memory             # memory | redis
REDIS_URL=redis://localhost:6379/0

# ── LLM providers (comma-separated key pools) ──────────────
# Mycel's GROQ_EXTREME_POOL / GEMINI_API_KEY names are also accepted.
GROQ_API_KEYS=
GEMINI_API_KEYS=
LLM_MODEL_SMART=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_FALLBACK_MODEL=gemini-3.8-flash
LLM_MAX_CONCURRENCY=4
# Azure OpenAI (tried first when set; Groq and Gemini become fallbacks).
# Endpoint is the resource URL from the Azure portal, deployment is the name you gave the model deployment.
# With Azure in front you can raise LLM_MAX_REQUEST_TOKENS (Groq free tier caps requests at 8k).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_DEPLOYMENT_FAST=
# GitHub Models (free GPT with a GitHub token that has "Models: read"; tried after Azure, before Groq).
# Create one at https://github.com/settings/personal-access-tokens. Comma-separate several tokens to pool them.
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini
GITHUB_MODELS_MODEL_FAST=openai/gpt-4.1-mini

# ── Sandbox ────────────────────────────────────────────────
DATA_DIR=./var                 # mission workspaces live in DATA_DIR/workspaces
COMMAND_TIMEOUT_S=180
# Comma-separated folders target repos may be opened from. Empty = any local path.
ALLOWED_REPO_ROOTS=

# ── Governance (bounded autonomy) ──────────────────────────
APPROVAL_TIMEOUT_S=300         # unanswered approvals expire and count as "denied"
# Approval categories that skip the human, e.g. "install,test". Leave empty in production.
AUTO_APPROVE_CATEGORIES=
MISSION_MAX_TOOL_CALLS=400
MISSION_MAX_LLM_TOKENS=2000000
MISSION_MAX_WALL_CLOCK_S=2700
MISSION_MAX_IDENTICAL_FAILURES=3   # same failing call this many times = loop, refused
MISSION_MAX_CONSECUTIVE_FAILURES=8 # one agent failing this many calls in a row = stop and report

# ── LLM request limits ─────────────────────────────────────
# Groq's on_demand tier rejects any request over 8,000 tokens; agents fit their context to this.
LLM_MAX_REQUEST_TOKENS=7800
LLM_MAX_OUTPUT_TOKENS=2000

# ── Hiring and orchestration ───────────────────────────────
HIRING_LLM_MANDATES=false
ESCALATE_AFTER_FAILURES=2          # a task failing this often goes to a different specialist
ORCHESTRATOR_MAX_PARALLEL=3
REPAIR_MAX_ATTEMPTS=4              # fix → re-check rounds before a human is asked

# ── Execution ──────────────────────────────────────────────
# inline: missions run inside the API process (dev). queue: the API enqueues and
# `python -m app.worker` processes run them (needs BUS_BACKEND=redis and STORAGE_BACKEND=mongo,
# and a DATA_DIR shared by the API and the workers).
EXECUTION_MODE=inline
WORKER_CONCURRENCY=4
LEASE_TTL_S=60
JOB_CLAIM_AFTER_S=180
WORKER_MAX_DELIVERIES=5

# ── Security ───────────────────────────────────────────────
# Every API route needs a bearer token (POST /api/v1/auth/login). Roles: viewer < operator < approver < admin.
# AUTH_ENABLED=false makes every request a local admin — only on a trusted machine; refused in production.
AUTH_ENABLED=true
JWT_SECRET=                        # at least 32 characters; required in production
JWT_TTL_MINUTES=480
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=          # creates this admin on first start (at least 10 characters)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600          # all requests, per client address
LOGIN_RATE_LIMIT_PER_MINUTE=10     # per client address and username
MISSION_RATE_LIMIT_PER_MINUTE=20   # missions created per user
MAX_REQUEST_BYTES=2000000
METRICS_ENABLED=true               # Prometheus text at /api/v1/metrics — expose to your scraper only
